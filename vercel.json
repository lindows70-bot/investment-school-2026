{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "functions": {
    "src/app/api/stock-price/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/financials/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/stock-info/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/stock-price-history/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/school-league/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/lynch-classify/route.ts": {
      "maxDuration": 20
    },
    "src/app/api/lynch-batch/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/market-indices/route.ts": {
      "maxDuration": 20
    },
    "src/app/api/macro-data/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/fred/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/fedwatch/route.ts": {
      "maxDuration": 20
    },
    "src/app/api/shadow-13f/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/nps-portfolio/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/cron/morning-briefing/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/school-index/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/correlation-matrix/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/lynch-earnings-tracer/route.ts": {
      "maxDuration": 45
    },
    "src/app/api/guidance-radar/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/dividend-explorer/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/macro-ai-picks/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/satellite-scores/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/market-flow-kr/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/cron/market-flow-kr/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/blackrock/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/win-lose/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/hi52-radar/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/swing-radar/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron-health/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/market-breadth/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/earnings-reports/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/kr-earnings/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/insider-scan/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/insider-market/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/cron/etf-snap/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/etf-flow/route.ts": {
      "maxDuration": 120
    },
    "src/app/api/us-liquidity/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/nps-portfolio",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/shadow-13f?ticker=AAPL&name=Apple%20Inc&market=US",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/school-index",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/morning-briefing",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/macro-ai-picks?refresh=1",
      "schedule": "0 19 * * 1"
    },
    {
      "path": "/api/cron/satellite-scores",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/market-flow-kr",
      "schedule": "0 11 * * 1-5"
    },
    {
      "path": "/api/blackrock?refresh=1",
      "schedule": "0 21 * * 1"
    },
    {
      "path": "/api/cron/timing-watch",
      "schedule": "30 23 * * *"
    },
    {
      "path": "/api/win-lose",
      "schedule": "50 23 * * *"
    },
    {
      "path": "/api/re-honeycomb",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/tech-screener?refresh=1",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/hi52-radar?refresh=1",
      "schedule": "25 0 * * *"
    },
    {
      "path": "/api/swing-radar?refresh=1",
      "schedule": "40 21 * * *"
    },
    {
      "path": "/api/market-breadth?refresh=1",
      "schedule": "35 0 * * *"
    },
    {
      "path": "/api/cron-health",
      "schedule": "40 0 * * *"
    },
    {
      "path": "/api/cron-health?pass=2",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron-health?pass=3",
      "schedule": "40 6 * * *"
    },
    {
      "path": "/api/cron/earnings-reports",
      "schedule": "20 0 * * *"
    },
    {
      "path": "/api/cron/kr-earnings",
      "schedule": "15 0 * * *"
    },
    {
      "path": "/api/cron/core-reco",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/insider-scan?slot=1",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/cron/insider-scan?slot=2",
      "schedule": "20 10 * * *"
    },
    {
      "path": "/api/cron/insider-scan?slot=3",
      "schedule": "20 21 * * *"
    },
    {
      "path": "/api/insider-market?refresh=1",
      "schedule": "50 21 * * *"
    },
    {
      "path": "/api/cron/etf-snap",
      "schedule": "20 10 * * 2-6"
    },
    {
      "path": "/api/etf-flow?refresh=1",
      "schedule": "35 10 * * 2-6"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/api/fred",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=43200, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/api/macro-data",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=43200, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/stock-price?ticker=AAPL&market=US"
    }
  ]
}
